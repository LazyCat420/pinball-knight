# Playtest screenshot runs (scripts/playtest.mjs --shots --shot-dir …). Review
# artifacts, not source: a wave produces hundreds of PNGs and none of them are
# the deliverable.
playtest-shots/
shots-*/

# Render-harness output (scripts/card-sheet.mjs, card-hover.mjs, card-sizes.mjs,
# glyph-sheet.mjs). Same rule as playtest-shots: these are how a card face gets
# LOOKED AT during a change, not something the game ships.
scratchpad/

# Agent scratch worktrees (see .dockerignore) — a checkout, never source.
# Both spellings: `.claude/worktrees/` is the documented one, `.worktrees/` is
# what the sun root uses, and a session that reaches for the familiar name left
# an untracked directory that blocked every deploy until someone noticed.
# NB `.claude/*` and not `.claude/` — git cannot re-include a path whose PARENT
# directory is excluded, so ignoring the directory itself makes the negation
# below silently do nothing. Excluding the contents is what allows the exception.
.claude/*
# The skills are the durable entry point to the pipeline and must not live only
# on one machine — that is how three sessions each re-derived the same thing.
# The documentation chapters remain the source of truth; a skill points at them.
!.claude/skills/
.worktrees/
.fx-motion/
*:Zone.Identifier
.build/
.rip/

# Mega-map output: regenerable, and the SVGs are ~0.5MB each. The PNGs and
# reports ARE committed — a findings document that points at images nobody has
# is not a finding.
debug/mega-map/*.svg

# Ad-hoc debug probes, written against a live symptom and kept only while it
# lasts (black screen, intro freeze, device caps). Nothing references them —
# not package.json, not docs, not scripts — and the deploy gate refuses any
# untracked file, so an unignored probe blocks every deploy until someone
# deletes another session's debugging.
.black-screen-probe*.mjs
.freeze-probe.mjs
scripts/test_device.mjs

# Benchmark results — a run artifact, not source. `bench-moveset.mjs` writes
# one per creature beside itself.
src/game/pinball-knight/tools/sprite-forge/comfy/bench-*.json
