node_modules/
.pnp.*
.yarn/
venv/

# ======================================
# Build output
# ======================================
dist/
build/
*.tgz

# Sprite ingest scratch. `npm run sprites` rewrites work/<name>/ from scratch on
# every run (rmSync then mkdir), so tracking it would commit regenerable output
# and churn a diff on every run. The SOURCE sheets in inbox/ are the artifact.
#
# NOTHING ELSE MAY LIVE HERE. On 2026-08-03 this directory was holding the only
# copy of the don-quixote sheets — 4.8MB of generated art, untracked, one `git
# clean` from gone. They are in sources/ now. A sheet you cannot check out is a
# sheet you have already lost; put new art in sources/, not here.
src/game/pinball-knight/tools/sprite-forge/work/
src/game/pinball-knight/tools/sprite-forge/pixel-trace/work/

# `scripts/sprite-shot.mjs --out` default: screenshots of a creature alive in
# the real dungeon, taken to JUDGE a sheet, not to keep. Regenerable from the
# published art in one command, and the deploy gate refuses any untracked file
# in the tree — so leaving this unignored means every art check blocks a deploy.
# (It is a JUDGEMENT, not an artifact: the same rule as work/ above, and the
# artifact it judges is already tracked in public/sprites/.)
.sprite-shot/

# `scripts/moveset-lab.mjs --out` default: the same rule, one level up. A
# contact sheet of every (facing, clip) a creature owns, cropped from the LIVE
# atlas — a judgement about art that is already tracked in public/sprites/, and
# regenerable with `npm run moveset`. Untracked files block the deploy gate.
.moveset/

# The Python half of sprite-forge is a package, not a bundled dependency.
src/game/pinball-knight/tools/sprite-forge/python/.venv/
src/game/pinball-knight/tools/sprite-forge/python/*.egg-info/
__pycache__/
.pytest_cache/

