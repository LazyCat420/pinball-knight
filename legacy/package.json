{
  "name": "lazycat-jungle-room",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5174",
    "build": "next build",
    "start": "node server.mjs",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:budget": "scripts/with-cores.sh CPUS=4 --wsl -- vitest run",
    "playtest": "node scripts/playtest.mjs",
    "playtest:gpu": "node scripts/playtest.mjs --gpu --profile",
    "playtest:soak": "node scripts/playtest.mjs --mode bounce --secs 300 --profile",
    "playtest:watch": "node scripts/playtest.mjs --watch --shots",
    "audit": "node scripts/audit-checklist.mjs",
    "audit:gpu": "node scripts/audit-checklist.mjs --gpu",
    "webgpu:check": "node scripts/webgpu-check.mjs",
    "webgpu:check:local": "node scripts/webgpu-check.mjs --url http://localhost:5174/dungeon",
    "sprites": "vitest run src/game/pinball-knight/tools/sprite-forge",
    "pixels": "node src/game/pinball-knight/tools/pixel-trace/trace.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "cannon-es": "^0.20.0",
    "gsap": "^3.12.7",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/three": "^0.185.1",
    "canvas": "^3.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
